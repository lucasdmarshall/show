{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "show-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "show-server",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "--manifest-path", "server/Cargo.toml", "--", "serve"],
      "port": 8080
    }
  ]
}
