# SHOW server — copy to .env and adjust.

# where it listens, and how the world reaches it (every URL it hands out)
SHOW_BIND=127.0.0.1:8080
SHOW_PUBLIC_URL=http://localhost:8080
# comma-separated web origins allowed to call with the session cookie
SHOW_ORIGINS=http://localhost:3000
# accounts, generations, portfolios, event photos
SHOW_DATA=data

# OpenRouter — one key for both image models and the prompt refiner.
# With a key set, SHOW_PROVIDER defaults to openrouter.
# OPENROUTER_API_KEY=
# SHOW_MODEL_NANO=google/gemini-3-pro-image
# SHOW_MODEL_SUNBURST=openai/gpt-image-2.5-sunburst
# SHOW_REFINE_MODEL=openai/gpt-4.1   (openai/gpt-4 for the original; ~15x the cost)
# SHOW_REFINE_DAILY=120

# who makes the photographs: openrouter | dev | openai | comfyui
#   dev      deterministic stand-ins, no key, no GPU — for building and testing
#   openai   OPENAI_API_KEY required; SHOW_OPENAI_MODEL defaults to gpt-image-1
#   comfyui  a ComfyUI the studio runs; COMFYUI_URL and COMFYUI_CKPT
# SHOW_PROVIDER=dev
# OPENAI_API_KEY=
# SHOW_OPENAI_MODEL=gpt-image-1
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_CKPT=sdxl_base_1.0.safetensors

# 1 = every signed-in account counts as a member. Never in production.
SHOW_DEV_PREMIUM=0

# Local test account, used to exercise the web app against a dev server:
#   login 09000000001 · password show-dev-2026
# make it a member with:  cargo run -- grant 09000000001 30

# Firebase Auth: the project whose ID tokens sign people in (Google, phone, email)
# FIREBASE_PROJECT_ID=
